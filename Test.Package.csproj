<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>

    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <EnableMsixTooling>true</EnableMsixTooling>
    <UseSdkBuildToolsPackage>true</UseSdkBuildToolsPackage>

    <WindowsPackageType>MSIX</WindowsPackageType>
    <PublishAppxPackage>true</PublishAppxPackage>

    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>

    <AppxPackageName>$(AssemblyName)</AppxPackageName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**\*.png" />
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>